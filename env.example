# Copy this file to .env and fill it in. Never commit .env.

# Public address of the site, no trailing slash. Used for Stripe return links and gift links.
# On Render, leave this empty to use the onrender.com address; set it once you have your own domain.
BASE_URL=http://localhost:3000
PORT=3000

# Private preview. When set, only people with this code can make songs (gift pages stay open).
# Invite someone with a link like  https://your-site/?code=THE-CODE
# Leave empty on the public site.
ACCESS_CODE=

# How many proxies sit between visitors and the site. 1 suits most hosts. The admin page shows the
# address the site sees you as; if that isn't your own, raise this by one.
TRUST_PROXY=1

# Where the database and song files live. On a host, point this at a persistent disk.
DATA_DIR=./data

# Shown on the policy pages as the place to write to.
SUPPORT_EMAIL=

# --- Music engine: elevenlabs | sunoapi | mock ---
# Change this one line to swap engines. Nothing else in the site changes.
MUSIC_ENGINE=elevenlabs

# ElevenLabs Music (https://elevenlabs.io) - needs a paid plan for commercial use
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=music_v2_5
ELEVENLABS_MAX_SECONDS=210
# How long the singer gets per lyric line. Raise it if songs sound rushed.
ELEVENLABS_SECONDS_PER_LINE=4.5

# sunoapi.org (unofficial Suno reseller) - for testing only.
# Checkout stays off with this engine unless ALLOW_UNOFFICIAL_ENGINE=1.
SUNOAPI_KEY=
SUNOAPI_MODEL=V6
SUNOAPI_DURATION=180
ALLOW_UNOFFICIAL_ENGINE=

# --- Lyrics: Claude API (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# The model that checks a customer's own words against the content rules before recording.
# Leave empty to use ANTHROPIC_MODEL. A smaller model is cheaper and faster.
ANTHROPIC_REVIEW_MODEL=

# --- Payments: Stripe (https://dashboard.stripe.com) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 to have Stripe work out and collect sales tax (turn on Stripe Tax in your dashboard first).
STRIPE_AUTOMATIC_TAX=
PRICE_GOLD_CENTS=2499
PRICE_PLATINUM_CENTS=3999

# --- Messages (links, receipts, scheduled songs, reminders) ---
# "log" queues messages on the admin page without sending them.
# "resend" sends email through Resend (https://resend.com): fill in the two lines below it. Email only: while it is
# the provider, the site asks customers for an email address and does not take mobile numbers.
# While nothing can be sent, "Send it for me on a date" and reminders are not offered to customers.
MESSAGE_PROVIDER=log
RESEND_API_KEY=
# Who emails come from. The domain must be verified in your Resend account.  Example: Songpost <hello@your-domain.com>
MAIL_FROM=
# Where replies go, if somewhere different.
MAIL_REPLY_TO=
# Added to the end of reminder emails. US law expects promotional email to carry your postal address.
MAIL_FOOTER=
# The hour, in UTC, when scheduled songs go out. 15 is mid-morning in US Central time.
SEND_HOUR_UTC=15

# --- Limits that protect you from paying for songs nobody buys ---
PREVIEW_SECONDS=30
TAKES_PER_ORDER=2
# Unpaid recordings one visitor can make in a day. Failed recordings and songs that get paid for don't count.
SONGS_PER_IP_PER_DAY=3
DAILY_UNPAID_SONG_CAP=150
LYRICS_PER_IP_PER_HOUR=20
# The audio of a preview nobody paid for is deleted after this many days. 0 keeps it for ever.
UNPAID_KEEP_DAYS=30

# --- The free redo ---
# Days after paying that a customer can record their song again, once. Keep it in step with the refund policy page.
REDO_DAYS=7

# --- What things cost, for the "Costs and earnings" figures on the admin page ---
# These are the suppliers' list prices. They only change what the admin page reports.
COST_MUSIC_PER_MINUTE=0.15
COST_CLAUDE_INPUT_PER_MTOK=2
COST_CLAUDE_OUTPUT_PER_MTOK=10
CARD_FEE_PERCENT=2.9
CARD_FEE_FIXED_CENTS=30
# Hosting and plans, in dollars a month (shown beside the figures, not subtracted from them).
MONTHLY_FIXED_COSTS=14

# Password for the /admin page. Leave empty to turn the page off.
# Make it long and random. Ten wrong tries from one address lock that address out for an hour.
ADMIN_KEY=

# Local testing only: practice lyrics and a fake checkout when keys are missing. Never set on the live site.
DEV_MOCKS=
